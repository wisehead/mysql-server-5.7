{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "/usr/include",
                "/usr/local/include",
                "${workspaceFolder}/build/include"
            ],
            "defines": [
                "MUTEX_EVENT",
                "UNIV_DEBUG",
                "MYSQL_SERVER",
                "HAVE_REPLICATION",
                "ENABLED_DEBUG_SYNC"
            ],
            "compilerPath": "/usr/bin/gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64"
        }
    ],
    "version": 4
}